# Server
PORT=4003
NODE_ENV=development

# Suppresses dotenv's random promotional "tip" line on every load (e.g.
# `dev`, `migrate`, `seed`) — pure log noise, not app config.
DOTENV_CONFIG_QUIET=true

# CORS — comma-separate multiple origins
ALLOWED_ORIGINS=https://example.com

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# GraphQL query hardening — defaults shown below, override only if you know
# why. QUERY_DEPTH_LIMIT bounds nesting; MAX_QUERY_COMPLEXITY bounds total
# selected fields (catches wide-but-shallow alias abuse depth alone misses).
# QUERY_DEPTH_LIMIT=7
# MAX_QUERY_COMPLEXITY=1000

# Max size of a single incoming JSON request body.
# JSON_BODY_LIMIT=100kb

# Global request rate limiting — off by default (0) so it never interferes
# with e2e/API/k6-smoke tests or a manual `npm run loadtest` run, all of
# which legitimately fire many requests from one IP in a short window. Set
# RATE_LIMIT_MAX to a positive number to enable it in production.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000

# Shared secret required on the /metrics endpoint (sent as the
# X-Metrics-Token header) — leave unset in dev so a local Prometheus/curl
# check just works. Set this in production so Node version, memory, and
# request-rate fingerprints aren't world-readable.
# METRICS_TOKEN=change-this-to-a-long-random-secret

# Database
DATABASE_CLIENT=mysql2
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=graphql_mysql
DATABASE_USER=
DATABASE_PASSWORD=
# rds = TLS verified against the Amazon RDS CA bundle bundled with mysql2
# (the AWS deployment, see docs/deployment.md). Unset for the local MySQL.
# DATABASE_SSL=rds

# Connection pool size (defaults: min 2, max 10)
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Read replica — optional. When set, list/browse queries and DataLoader batch
# fetches route to this host instead of DATABASE_HOST; point reads by id and
# everything inside a mutation stay on the primary (read-your-writes safety).
# No automatic failover: if the replica is unreachable, only the reads routed
# to it fail.
# DATABASE_REPLICA_HOST=localhost
# DATABASE_REPLICA_PORT=3306

# MySQL root password (used by docker-compose only)
MYSQL_ROOT_PASSWORD=

# Redis — required in production for GraphQL subscriptions, the
# distributed login rate limiter, and the JWT verification cache. Optional
# in development (falls back to in-memory/DB-every-time behavior). A
# `redis` service is included in docker-compose.yml — uncomment to use it:
# REDIS_URL=redis://localhost:6379

# Kafka — event backbone for comment.created; the broker is part of the
# default `docker compose up` stack (see docker-compose.yml). If unset, the
# app still runs fine and mutations publish straight onto the Redis/
# in-memory PubSub above instead.
# localhost:9092 below is for the app running on the host (npm run dev,
# test:integration, test:e2e) against the dockerized broker's published
# port. docker-compose.yml overrides this to kafka:19092 for the
# containerized app itself — same pattern as DATABASE_HOST below it.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=graphql-node
KAFKA_CONSUMER_GROUP=graphql-node-subscriptions

# Observability — /metrics (Prometheus) and /health, /ready are always on.
# Distributed tracing is optional; when unset, no tracing overhead is added.
# Start a local Jaeger with: docker compose --profile observability up -d jaeger
# (UI at http://localhost:16686). Use http://localhost:4318 when running the
# app with `npm run dev` on the host, or http://jaeger:4318 when the app
# itself also runs inside docker compose.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=graphql-node

# Logging
LOG_LEVEL=info
